{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {"builder": "DOCKERFILE", "dockerfilePath": "Dockerfile"},
  "deploy": {"startCommand": "sh -c 'exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1'", "healthcheckPath": "/health", "healthcheckTimeout": 180, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3}
}
